{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-run-hook.mjs\"", "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-stop-hook.mjs\"", "timeout": 15}
        ]
      }
    ]
  }
}
